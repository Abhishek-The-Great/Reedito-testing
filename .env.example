# Environment variables for Reedito development with docker compose
## Use this file by running `cp .env.example .env` and then editing the values as needed

# Debug level to pass to Reedito
# DEBUG=

# Optional Reedito Admin changelog JSON feed, injected at build time
# REEDITO_CHANGELOG_URL=

# Optional migration iframe service. If enabled, it receives an Admin API key and owner email.
# REEDITO_MIGRATION_URL=

# Optional owner/repository slug for Reedito Admin version links
# REEDITO_GITHUB_REPOSITORY=

# Optional Sentry DSNs. The server DSN reports Core 500 errors; the client DSN
# enables Sentry integrations that consume Reedito's public client configuration.
# sentry__dsn=
# client_sentry__dsn=

# Optional CI secret for uploading browser source maps to Sentry. Runtime error
# reporting does not require this token.
# VITE_SENTRY_AUTH_TOKEN=

# Mailgun API credentials - used with `pnpm dev:mailgun`
## Mailgun sending domain
# MAILGUN_DOMAIN=
## From address for transactional emails. Defaults to postmaster@MAILGUN_DOMAIN.
# MAILGUN_FROM=
## Mailgun API key
# MAILGUN_API_KEY=
## Mailgun API origin for transactional emails. Use https://api.eu.mailgun.net for EU domains.
# MAILGUN_API_URL=https://api.mailgun.net
## Mailgun API base URL for newsletter/bulk emails. Use https://api.eu.mailgun.net/v3 for EU domains.
# MAILGUN_BASE_URL=https://api.mailgun.net/v3
