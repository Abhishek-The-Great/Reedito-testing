# syntax=docker/dockerfile:1-labs@sha256:63e440b412b6acba117974e793b7e7f702e58ee65e044bdff1b8d388ee0d853b

# Production Dockerfile for Reedito
# Targets:
#   deploy — build the prod dependency closure + a self-contained /home/reedito
#            (build-only stage, never shipped)
#   report — per-package sizes of that closure, for CI (build-only, not shipped)
#   core — server + production deps, no admin (Reedito-Pro base)
#   full — core + built admin (self-hosting)
#
# Build context: the monorepo repo root. The deploy stage runs `pnpm deploy`
# against the workspace to produce a self-contained app dir (source + resolved
# node_modules), so this image no longer depends on the `pnpm pack` output that
# Reedito-CLI uses (scripts/pack.mjs). The `full` stage's admin build is prepared
# in the context by `pnpm build:production`.
#
# Ownership model: application code (node_modules, server source, admin) is owned
# by nobody:nogroup so the runtime user (reedito, uid 1000) can read but not modify
# it; the writable content and log dirs are owned by reedito. Ownership is set at
# COPY time (COPY --chown) rather than via a post-hoc `chown -R`: on overlayfs a
# recursive chown copies every touched file into a new layer, which previously
# duplicated node_modules (~600MB) and the admin build (~80MB) and inflated every
# image pull.

ARG NODE_VERSION=22.23.1

# ---- deploy: build closure + self-contained app dir (build-only, not shipped) ----
FROM node:$NODE_VERSION-bookworm-slim AS deploy

WORKDIR /build

RUN corepack enable

# Full workspace source is needed so pnpm can resolve the workspace graph for the
# `reedito...` filter. .dockerignore prunes node_modules/build/dist/.git/.nx so the
# build starts from a clean tree and rebuilds outputs in-container.
#
# --exclude core/built: for the `full` target the admin build is present in the
# context at reedito/core/core/built/admin. Excluding the whole built dir (not just
# built/admin — the built dir itself is absent on a fresh checkout, so excluding
# only its child would still leave a differing directory entry) keeps this COPY
# layer's hash identical between the core and full builds. That lets `full` reuse
# `core`'s cached deploy/install/build layers instead of re-running the whole
# closure build, and keeps admin out of the deploy output so `core` stays
# admin-free. The server's own core/built output is regenerated in-container by the
# build steps below, so nothing is lost by excluding the host copy.
COPY --exclude=reedito/core/core/built . .

# Install only reedito and its dependency subgraph (`reedito...`), not the whole
# monorepo (admin, apps, ...). Dev deps are included — tsc etc. are needed to build
# the closure. Scripts are NOT ignored: better-sqlite3's install script runs and
# prebuild-install fetches its prebuilt binary (permitted by allowBuilds in
# pnpm-workspace.yaml). No build-essential/python3 is installed, so a node-gyp
# source-compile fallback fails loudly instead of silently pulling a toolchain into
# a discarded layer.
RUN --mount=type=cache,target=/root/.local/share/pnpm/store,id=pnpm-store \
    pnpm install --filter "reedito..." --frozen-lockfile --prefer-offline

# Build reedito's production workspace dependency closure (kg-*/adapters; @reedito/i18n
# has no build script and is skipped) plus reedito's own server output. Driven with
# pnpm recursive filters rather than nx to avoid the NX_NATIVE_COMMAND_RUNNER
# segfault workaround inside the container.
RUN pnpm --filter-prod "reedito^..." -r run build && \
    pnpm --filter reedito run build:tsc && \
    pnpm --filter reedito run build:assets

# Produce a self-contained deploy dir: reedito/core's `files` set + a fully resolved,
# production-only node_modules (--prod drops devDeps, keeps optional better-sqlite3).
# Admin is never built here, so core/built/admin is absent — the core image stays
# admin-free and the full stage injects admin from the build context.
#
# inject-workspace-packages: hard-copy the workspace deps (kg-*/adapters/i18n) into
# node_modules instead of linking them back to the workspace. The deploy dir is
# COPYed into the runtime image away from the workspace, so links would dangle.
RUN --mount=type=cache,target=/root/.local/share/pnpm/store,id=pnpm-store \
    pnpm --filter=reedito --config.inject-workspace-packages=true deploy --prod /home/reedito

# Strip type-time, doc and native-build-input files the runtime never loads — see
# reedito/core/scripts/prune.mts for the rules and the exclusions they carry. The COPY
# layer below is extracted single-threaded, once per CI E2E shard, and that cost
# scales with file count: this removes roughly half of them.
RUN node reedito/core/scripts/prune.mts /home/reedito --profile=image --report=/image-report.json

# Fail the build now if the native module didn't install correctly (missing/broken
# prebuilt binary) rather than at container runtime.
RUN cd /home/reedito && node -e "require('better-sqlite3'); console.log('better-sqlite3 OK')"

# ---- report: per-package sizes of the shipped node_modules (build-only) ----
# CI extracts this with `--target=report --output=type=local` and diffs it against
# the base commit's report, so a dependency that duplicates a large package (a
# peer-forked viem, say) is visible on the PR that adds it. Every layer in `deploy`
# is already cached by the core build, so this target costs an export, not a build.
FROM scratch AS report

COPY --from=deploy /image-report.json /

# ---- Core: server + production deps ----
FROM node:$NODE_VERSION-bookworm-slim AS core

ENV NODE_ENV=production

RUN apt-get update && \
    apt-get install -y --no-install-recommends libjemalloc2 fontconfig && \
    rm -rf /var/lib/apt/lists/* && \
    groupmod -g 1001 node && \
    usermod -u 1001 node && \
    adduser --disabled-password --gecos "" -u 1000 reedito

WORKDIR /home/reedito

# The deploy stage produced a self-contained app dir (server source + resolved
# node_modules, no admin). Copy it once with its final ownership — no separate
# `chown -R` layer, so node_modules isn't duplicated in the image.
COPY --chown=nobody:nogroup --from=deploy /home/reedito ./

# cp -a preserves the nobody:nogroup ownership set at COPY time, so base_content
# and default need no re-chown; only the writable content/log dirs flip to reedito.
RUN mkdir -p default log && \
    cp -a content base_content && \
    cp -a content/themes/casper default/casper && \
    ([ -d content/themes/source ] && cp -a content/themes/source default/source || true) && \
    chown reedito:reedito /home/reedito && \
    chown nobody:nogroup default && \
    chown -R reedito:reedito content log

ARG REEDITO_BUILD_VERSION=""
ENV REEDITO_BUILD_VERSION=${REEDITO_BUILD_VERSION}

USER reedito
ENV LD_PRELOAD=libjemalloc.so.2

EXPOSE 2368

CMD ["node", "index.js"]

# ---- Full: core + admin ----
FROM core AS full

# COPY --chown sets ownership in the copy layer; a post-hoc `chown -R` would
# duplicate the ~80MB admin build into a second layer. Admin is built in the
# context by `pnpm build:production` at
# reedito/core/core/built/admin — the deploy stage excludes that path, so this is the
# only stage that carries admin. Local `full` builds must populate that path first
# (e.g. `pnpm build:production`).
COPY --chown=nobody:nogroup reedito/core/core/built/admin core/built/admin

# Public UMD apps are served by the Admin static route, on the Reedito origin.
# Build their `umd/` outputs with `pnpm build:production` before this Docker build.
COPY --chown=nobody:nogroup apps/portal/umd/*.min.js core/built/admin/assets/portal/
COPY --chown=nobody:nogroup apps/portal/umd/*.css core/built/admin/assets/portal/
COPY --chown=nobody:nogroup apps/comments-ui/umd/*.min.js core/built/admin/assets/comments-ui/
COPY --chown=nobody:nogroup apps/sodo-search/umd/*.min.js core/built/admin/assets/sodo-search/
COPY --chown=nobody:nogroup apps/sodo-search/umd/*.css core/built/admin/assets/sodo-search/
COPY --chown=nobody:nogroup apps/signup-form/umd/*.min.js core/built/admin/assets/signup-form/
COPY --chown=nobody:nogroup apps/announcement-bar/umd/*.min.js core/built/admin/assets/announcement-bar/
COPY --chown=nobody:nogroup apps/admin-toolbar/umd/*.min.js core/built/admin/assets/admin-toolbar/
