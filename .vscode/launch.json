  "version": "0.2.0",
  "configurations": [
    {
      "args": ["run", "-c", "vitest.config.db.ts", "--project", "e2e-api"],
      "cwd": "${workspaceFolder}/reedito/core",
      "internalConsoleOptions": "openOnSessionStart",
      "name": "E2E API Tests",
      "program": "${workspaceFolder}/reedito/core/node_modules/.bin/vitest",
      "request": "launch",
      "skipFiles": ["<node_internals>/**"],
      "env": {
        "NODE_ENV": "testing-mysql"
      },
      "type": "node"
    }
  ]
}
