{
  "editor.quickSuggestions": {
    "strings": true
  },
  "eslint.workingDirectories": [
    {
      "pattern": "./apps/*/"
    },
    {
      "pattern": "./reedito/*/"
    },
    {
      "pattern": "./koenig/*/"
    }
  ],
  "search.exclude": {
    "**/.git": true,
    "**/build/*": true,
    "**/coverage/**": true,
    "**/dist/**": true,
    "**/reedito.map": true,
    "**/node_modules": true,
    "reedito/core/core/built/**": true,
    ".claude/worktrees/**": true,
    "**/config.*.json": false,
    "**/config.*.jsonc": false
  },
  "tailwindCSS.experimental.classRegex": [["clsx\\(([^)]*)\\)", "(?:'|\"|`)([^']*)(?:'|\"|`)"]],
  "git.detectSubmodules": false,
  "[typescript]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  }
}
