{
  "name": "@reedito/admin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "pnpm test:unit",
    "test:unit": "vitest run",
    "test:acceptance": "vitest run -c vitest.acceptance.config.ts",
    "test:acceptance:watch": "vitest -c vitest.acceptance.config.ts",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@codemirror/lang-css": "catalog:",
    "@codemirror/lang-html": "catalog:",
    "@codemirror/lang-javascript": "catalog:",
    "@codemirror/lang-json": "catalog:",
    "@codemirror/lang-markdown": "catalog:",
    "@codemirror/lang-yaml": "catalog:",
    "@codemirror/search": "catalog:",
    "@codemirror/state": "catalog:",
    "@codemirror/theme-one-dark": "catalog:",
    "@dnd-kit/sortable": "catalog:",
    "@radix-ui/react-focus-guards": "catalog:",
    "@radix-ui/react-focus-scope": "catalog:",
    "@sentry/react": "catalog:",
    "@svg-maps/world": "2.0.0",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-virtual": "catalog:",
    "@reedito/activitypub": "workspace:*",
    "@reedito/admin-x-framework": "workspace:*",
    "@reedito/checkout": "workspace:*",
    "@tryghost/color-utils": "catalog:",
    "@tryghost/custom-fonts": "catalog:",
    "@reedito/i18n": "workspace:*",
    "@reedito/kg-clean-basic-html": "workspace:*",
    "@reedito/kg-unsplash-selector": "workspace:*",
    "@reedito/koenig-lexical": "workspace:*",
    "@reedito/metafield-types": "workspace:*",
    "@tryghost/nql": "catalog:",
    "@tryghost/nql-lang": "catalog:",
    "@reedito/nql-string": "workspace:*",
    "@reedito/shade": "workspace:*",
    "@tryghost/string": "catalog:",
    "@tryghost/timezone-data": "catalog:",
    "@uiw/react-codemirror": "catalog:",
    "@xyflow/react": "12.11.2",
    "clsx": "catalog:",
    "dequal": "catalog:",
    "dompurify": "catalog:",
    "flexsearch": "catalog:",
    "i18n-iso-countries": "7.14.0",
    "jszip": "3.10.1",
    "lucide-react": "catalog:",
    "luxon": "catalog:",
    "mingo": "catalog:",
    "moment": "catalog:",
    "moment-timezone": "catalog:",
    "papaparse": "5.5.4",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "catalog:",
    "react-svg-map": "2.2.0",
    "semver": "catalog:",
    "sonner": "catalog:",
    "temporal-polyfill": "catalog:",
    "use-debounce": "10.1.1",
    "validator": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@internal/cfg-eslint": "workspace:*",
    "@internal/cfg-eslint-react": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@reedito/test-data": "workspace:*",
    "@types/node": "catalog:",
    "@types/papaparse": "5.5.2",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/react-svg-map": "2.1.4",
    "@types/semver": "catalog:",
    "@types/validator": "catalog:",
    "@typescript/native": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "d3-geo": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-no-relative-import-paths": "1.6.1",
    "reedito-admin": "workspace:*",
    "jsdom": "catalog:",
    "msw": "catalog:",
    "sirv": "3.0.2",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vitest-browser-react": "catalog:"
  },
  "nx": {
    "tags": [
      "playwright"
    ],
    "targets": {
      "test:unit": {
        "dependsOn": [
          "^build"
        ]
      },
      "test:acceptance": {
        "dependsOn": [
          "^build"
        ]
      },
      "dev": {
        "continuous": true,
        "executor": "nx:run-commands",
        "options": {
          "cwd": "apps/admin",
          "command": "vite"
        },
        "dependsOn": [
          "reedito-monorepo:docker:up",
          "reedito-admin:dev",
          "@reedito/admin-x-framework:dev",
          "@reedito/shade:dev"
        ]
      },
      "build:dev": {
        "dependsOn": [
          "^build",
          {
            "projects": [
              "reedito-admin"
            ],
            "target": "build:dev"
          }
        ]
      },
      "build": {
        "inputs": [
          {
            "env": "REEDITO_CDN_URL"
          },
          {
            "env": "IS_SHIPPING"
          },
          "default",
          "^default"
        ],
        "outputs": [
          "{projectRoot}/dist",
          "{workspaceRoot}/reedito/core/core/built/admin"
        ],
        "dependsOn": [
          "^build",
          {
            "projects": [
              "reedito-admin"
            ],
            "target": "build"
          }
        ]
      },
      "lint": {
        "dependsOn": [
          {
            "projects": [
              "@reedito/admin-x-framework",
              "@reedito/checkout",
              "@reedito/metafield-types",
              "@reedito/shade"
            ],
            "target": "build"
          }
        ]
      }
    }
  }
}
