{
  "name": "@reedito/e2e",
  "version": "0.0.0",
  "private": true,
  "author": "Reedito contributors",
  "files": [
    "build"
  ],
  "type": "module",
  "scripts": {
    "dev": "tsc --watch --preserveWatchOutput --noEmit",
    "build": "pnpm test:types",
    "build:ts": "tsc --noEmit",
    "build:apps": "pnpm nx run-many --target=build --projects='tag:public-app'",
    "build:docker": "docker build -f Dockerfile.e2e --build-arg REEDITO_IMAGE=${REEDITO_E2E_BASE_IMAGE:?Set REEDITO_E2E_BASE_IMAGE} -t ${REEDITO_E2E_IMAGE:-reedito-e2e:local} ..",
    "pretest": "test -n \"$CI\" || echo 'Tip: run pnpm dev or pnpm --filter @reedito/e2e infra:up before running tests'",
    "infra:up": "bash ./scripts/infra-up.sh",
    "infra:down": "bash ./scripts/infra-down.sh",
    "tinybird:sync": "node ./scripts/sync-tinybird-state.mjs",
    "preflight:build": "bash ./scripts/prepare-ci-e2e-build-mode.sh",
    "test": "bash ./scripts/run-playwright-host.sh playwright test --project=main",
    "test:analytics": "bash ./scripts/run-playwright-host.sh playwright test --project=analytics",
    "test:all": "bash ./scripts/run-playwright-host.sh playwright test --project=main --project=analytics",
    "test:single": "bash ./scripts/run-playwright-host.sh playwright test --project=main -g",
    "test:debug": "bash ./scripts/run-playwright-host.sh playwright test --project=main --headed --timeout=60000 -g",
    "test:types": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "lint": "eslint . --cache"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@faker-js/faker": "catalog:",
    "@playwright/test": "catalog:",
    "@reedito/checkout": "workspace:*",
    "@tryghost/debug": "catalog:",
    "@tryghost/logging": "catalog:",
    "@reedito/metafield-types": "workspace:*",
    "@reedito/test-data": "workspace:*",
    "@types/dockerode": "4.0.1",
    "@types/express": "catalog:",
    "@typescript/native": "catalog:",
    "busboy": "1.6.0",
    "dockerode": "5.0.1",
    "dotenv": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-ghost": "catalog:",
    "eslint-plugin-no-relative-import-paths": "1.6.1",
    "eslint-plugin-playwright": "2.10.4",
    "express": "4.22.2",
    "knex": "3.1.0",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "zod": "catalog:"
  }
}
