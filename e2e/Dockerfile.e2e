# E2E test layer: copies locally-built public apps into Reedito's built admin
# assets so Reedito serves them from /reedito/assets/* (same origin, no CORS).
#
# This mirrors the /reedito/assets/<app>/ paths used in dev mode. Don't serve
# them from /content/files/ — uploaded files there are deliberately served as
# inert types (text/plain + nosniff), so browsers won't execute the scripts.
#
# Usage:
#   docker build -f e2e/Dockerfile.e2e \
#     --build-arg REEDITO_IMAGE=reedito-monorepo:latest \
#     -t reedito-e2e:local .
#
# Intended for the production Reedito image built in CI (the `full` target, which
# includes the admin build).

ARG REEDITO_IMAGE=reedito-monorepo:latest
FROM $REEDITO_IMAGE

# Public app UMD bundles — Reedito serves core/built/admin/assets at /reedito/assets/
COPY apps/portal/umd /home/reedito/core/built/admin/assets/portal
COPY apps/comments-ui/umd /home/reedito/core/built/admin/assets/comments-ui
COPY apps/sodo-search/umd /home/reedito/core/built/admin/assets/sodo-search
COPY apps/signup-form/umd /home/reedito/core/built/admin/assets/signup-form
COPY apps/announcement-bar/umd /home/reedito/core/built/admin/assets/announcement-bar

ENV portal__url=/reedito/assets/portal/portal.min.js
ENV comments__url=/reedito/assets/comments-ui/comments-ui.min.js
ENV sodoSearch__url=/reedito/assets/sodo-search/sodo-search.min.js
ENV sodoSearch__styles=/reedito/assets/sodo-search/main.css
ENV signupForm__url=/reedito/assets/signup-form/signup-form.min.js
ENV announcementBar__url=/reedito/assets/announcement-bar/announcement-bar.min.js
