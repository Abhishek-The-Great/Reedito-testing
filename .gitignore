# Node template

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids
.reedito-dev
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
coverage*

# nyc test coverage
.nyc_output

# Grunt intermediate storage (http://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/
jspm_packages/

# Typescript v1 declaration files
typings/

# Optional npm cache directory
.npm

# Nx
.nxcache
.nx/cache
.nx/workspace-data

# Optional eslint cache
.eslintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# pnpm store
.pnpm-store

# dotenv environment variables file
.env
.env.production
secrets/

# IDE
.idea/
*.iml
*.sublime-*
.vscode/*
!.vscode/launch.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/extensions.json

# OSX
.DS_Store

!test/utils/fixtures/**/*.csv

# Reedito DB file
*.db
*.db-journal

/reedito/core/test-results/
/reedito/core/core/server/data/export/exported*
/reedito/core/content/tmp/*
/reedito/core/content/data/*
/reedito/core/content/logs/*
/reedito/core/content/settings/*
/reedito/core/content/apps/**/*
/reedito/core/content/themes/**/*
/reedito/core/content/images/**/*
/reedito/core/content/media/**/*
/reedito/core/content/files/**/*
/reedito/core/content/public/*
# Boot-generated public assets (admin-auth, .well-known) when tests use the
# fixtures dir as the content path — same as content/public above (PLA-152).
/reedito/core/test/utils/fixtures/public/
/reedito/core/content/adapters/storage/**/*
/reedito/core/content/adapters/scheduling/**/*
/reedito/core/content/themes/casper
/reedito/core/content/themes/source
!/reedito/core/README.md
!/reedito/core/content/**/README.md

# Changelog, which is autogenerated, not committed
/reedito/core/CHANGELOG.md

# Assets bundled into the release but we don't want to commit
/reedito/core/LICENSE
/reedito/core/PRIVACY.md
/reedito/core/README.md
/reedito/core/pnpm-lock.yaml

# Test generated files
test/functional/*.png

# ignore all custom json files for config
/reedito/core/config.*.json
/reedito/core/config.*.jsonc

# Build/deploy outputs
/reedito/core/package
/reedito/core/core/built
/reedito/core/core/frontend/public/reedito.min.css
/reedito/core/core/frontend/public/comment-counts.min.js
/reedito/core/core/frontend/public/member-attribution.min.js
/reedito/core/core/frontend/public/reedito-stats.min.js
/reedito/core/core/frontend/public/private.min.js
/reedito/core/core/frontend/public/cards.manifest.json
# Caddyfile - for local development with ssl + caddy
Caddyfile
!docker/dev-gateway/Caddyfile

# Playwright state with cookies it keeps across tests
/reedito/core/playwright-state.json
/reedito/core/playwright-report
/playwright-report
/test-results

# Admin
/apps/ember-admin/dist

# Admin Toolbar
/apps/admin-toolbar/umd

# Comments-UI
/apps/comments-ui/umd
/apps/comments-ui/playwright-report
/reedito/comments-ui/playwright/.cache/
/apps/comments-ui/test-results/

# Portal
!/apps/portal/.env
/apps/portal/umd

# Sodo-Search
/apps/sodo-search/public/main.css
/apps/sodo-search/umd

# Signup Form and local environments
/apps/signup-form/umd
/apps/signup-form/.env*.local
/apps/signup-form/test-results/
/apps/signup-form/playwright-report/
/apps/signup-form/playwright/.cache/

# Announcement-Bar
/apps/announcement-bar/umd

# Build files
/apps/*/build
/reedito/*/build
/koenig/*/build
/packages/**/build
# Typescript build artifacts
tsconfig.tsbuildinfo

# Admin X

# Tinybird
.tinyb
.venv
.diff_tmp
temp*.sql

# Docker pnpm Cache
.pnpmhash

# yalc — for linking local packages in a docker compatible way
yalc.lock
.yalc

# A folder for AI generated files
# useful for keeping local plans etc
/ai

# Amp generates thread-specific portal state at runtime
/.amp/portals/

# direnv environment loader files
.envrc

