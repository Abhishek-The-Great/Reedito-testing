# Copy to .env.production on the VPS and replace every placeholder.
# Keep .env.production private (chmod 600); it is ignored by Git.

REEDITO_IMAGE=reedito:production
REEDITO_DOMAIN=reedito.com
REEDITO_URL=https://reedito.com

MYSQL_DATABASE=reedito
MYSQL_USER=reedito

# Use an address on a domain verified with Resend.
MAIL_FROM="Reedito <no-reply@reedito.com>"

# Reedito's built-in bulk newsletter sender uses Mailgun's API.
MAILGUN_DOMAIN=your-verified-mailgun-domain
MAILGUN_BASE_URL=https://api.mailgun.net/v3

# Optional Sentry DSNs. Configure issue alerts in Sentry after adding them.
SENTRY_SERVER_DSN=
SENTRY_CLIENT_DSN=

# Cloudflare R2 destination for daily backups.
R2_ACCOUNT_ID=replace-with-cloudflare-account-id
R2_BUCKET=reedito-production-backups
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
BACKUP_INTERVAL_SECONDS=86400
